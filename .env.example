# Local development placeholders only. Never commit a populated .env file.
POSTGRES_DB=sentinelflow
POSTGRES_USER=sentinelflow
POSTGRES_PASSWORD=change-me-before-shared-use
API_PORT=8000
WEB_PORT=3000

SENTINELFLOW_ENVIRONMENT=development
SENTINELFLOW_LOG_LEVEL=INFO
SENTINELFLOW_DATABASE_URL=postgresql+asyncpg://sentinelflow:change-me-before-shared-use@localhost:5432/sentinelflow
SENTINELFLOW_REDIS_URL=redis://localhost:6379/0
SENTINELFLOW_CORS_ORIGINS=["http://localhost:3000"]
SENTINELFLOW_OTEL_ENABLED=false
SENTINELFLOW_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
