# Local development placeholders only. Never commit a populated .env file.
POSTGRES_DB=sentinelflow
POSTGRES_USER=sentinelflow
POSTGRES_PASSWORD=change-me-before-shared-use
API_PORT=8000
WEB_PORT=3000
WORKFLOW_RESULT_SIGNING_KEY=replace-with-at-least-32-random-bytes

SENTINELFLOW_ENVIRONMENT=development
SENTINELFLOW_LOG_LEVEL=INFO
SENTINELFLOW_DATABASE_URL=postgresql+asyncpg://sentinelflow:change-me-before-shared-use@localhost:5432/sentinelflow
SENTINELFLOW_REDIS_URL=redis://localhost:6379/0
SENTINELFLOW_WORKFLOW_EXECUTION_MODE=dry_run
SENTINELFLOW_WORKFLOW_RESULT_SIGNING_KEY=replace-with-at-least-32-random-bytes
SENTINELFLOW_AISOC_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes
# External mode: set one workspace UUID and paired HTTPS URL/token values per adapter.
# SENTINELFLOW_INTEGRATION_WORKSPACE_ID=11111111-1111-4111-8111-111111111111
# SENTINELFLOW_THREATGRAPH_BASE_URL=https://threatgraph.example.com
# SENTINELFLOW_THREATGRAPH_TOKEN=secret-managed-at-deploy-time
# SENTINELFLOW_REDMIND_BASE_URL=https://redmind.example.com
# SENTINELFLOW_REDMIND_TOKEN=secret-managed-at-deploy-time
# SENTINELFLOW_PATCHTOWER_BASE_URL=https://patchtower.example.com
# SENTINELFLOW_PATCHTOWER_TOKEN=secret-managed-at-deploy-time
# SENTINELFLOW_AUTOPENTEST_BASE_URL=https://autopentest.example.com
# SENTINELFLOW_AUTOPENTEST_TOKEN=secret-managed-at-deploy-time
# SENTINELFLOW_AISHIELD_BASE_URL=https://aishield.example.com
# SENTINELFLOW_AISHIELD_TOKEN=secret-managed-at-deploy-time
SENTINELFLOW_CORS_ORIGINS=["http://localhost:3000"]
SENTINELFLOW_OTEL_ENABLED=false
SENTINELFLOW_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
